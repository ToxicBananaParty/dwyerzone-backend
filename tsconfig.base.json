{
    "compilerOptions": {
        "target": "es2022",
        "module": "esnext",
        "skipLibCheck": true,

        "verbatimModuleSyntax": true,
        "moduleDetection": "force",

        "strict": true,
        "sourceMap": true,
        "forceConsistentCasingInFileNames": true,

        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "incremental": true,
        "noEmitOnError": true,
    }
}