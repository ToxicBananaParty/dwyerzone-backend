{
    "compilerOptions": {
        "target": "es2022",
        "skipLibCheck": true,

        "verbatimModuleSyntax": true,
        "module": "node16",
        "moduleDetection": "force",
        "moduleResolution": "node16",
        "baseUrl": ".",
        "paths": {
            "@smarthome/common": ["packages/common/src/index.ts"],
            "@smarthome/common/*": ["packages/common/src/*"],
            "@smarthome/solid-snake": ["packages/solid-snake/src/index.ts"],
            "@smarthome/solid-snake/*": ["packages/solid-snake/src/*"],
            "@smarthome/big-boss": ["packages/big-boss/src/index.ts"],
            "@smarthome/big-boss/*": ["packages/big-boss/src/*"],
            "@smarthome/colonel-roy": ["packages/colonel-roy/src/index.ts"],
            "@smarthome/colonel-roy/*": ["packages/colonel-roy/src/*"],
            "@smarthome/the-boss": ["packages/the-boss/src/index.ts"],
            "@smarthome/the-boss/*": ["packages/the-boss/src/*"]
        },
        "resolveJsonModule": true,
        "isolatedModules": true,

        "strict": true,
        "sourceMap": true,
        "forceConsistentCasingInFileNames": true,

        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "incremental": true,
        "noEmitOnError": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
    }
}