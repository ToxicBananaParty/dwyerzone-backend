{
    "compilerOptions": {
        "target": "es2022",
        "skipLibCheck": true,

        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "isolatedModules": true,

        "strict": true,
        "sourceMap": true,
        "forceConsistentCasingInFileNames": true,

        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "incremental": true,
        "noEmitOnError": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
    }
}