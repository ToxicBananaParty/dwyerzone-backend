{
    "compilerOptions": {
        "target": "es2022",
        "skipLibCheck": true,

        "verbatimModuleSyntax": true,
        "module": "esnext",
        "moduleDetection": "force",
        "moduleResolution": "bundler",
        "baseUrl": ".",
        "paths": {
            "@smarthome/common": ["apps/common/src/index.ts"],
            "@smarthome/common/*": ["apps/common/src/*"],
            "@smarthome/solid-snake": ["apps/solid-snake/src/index.ts"],
            "@smarthome/solid-snake/*": ["apps/solid-snake/src/*"],
            "@smarthome/big-boss": ["apps/big-boss/src/index.ts"],
            "@smarthome/big-boss/*": ["apps/big-boss/src/*"],
            "@smarthome/colonel-roy": ["apps/colonel-roy/src/index.ts"],
            "@smarthome/colonel-roy/*": ["apps/colonel-roy/src/*"],
            "@smarthome/the-boss": ["apps/the-boss/src/index.ts"],
            "@smarthome/the-boss/*": ["apps/the-boss/src/*"]
        },
        "resolveJsonModule": true,
        "isolatedModules": true,

        "strict": true,
        "sourceMap": true,
        "forceConsistentCasingInFileNames": true,

        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "incremental": true,
        "noEmitOnError": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
    }
}